# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- WordPress.com site ---
WP_SITE_URL=https://your-site.wpcomstaging.com
WP_ADMIN_USER_ID=

# --- SSH (preferred: gives WP-CLI) ---
# Host alias is configured in ~/.ssh/config
WP_SSH_ALIAS=
WP_SSH_KEY=~/.ssh/your-key

# --- SFTP (fallback for file uploads) ---
WP_SFTP_HOST=sftp.wp.com
WP_SFTP_PORT=22
WP_SFTP_USER=
WP_SFTP_PASSWORD=

# --- Server paths ---
WP_MU_PLUGINS_DIR=/srv/htdocs/wp-content/mu-plugins

# --- Payment gateway (not chosen yet) ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===========================================================================
# Order notification mail (server.js) — its own Vercel project, deployed from
# this repo by git. Nothing below reaches WordPress; the mu-plugin still goes
# up by scp exactly as before.
# ===========================================================================

# The WordPress origin this service re-prices against. Same value as the
# frontend repo's WP_STORE_URL — no VITE_ prefix anywhere, ever.
WP_STORE_URL=https://your-site.wpcomstaging.com

# Shared secret the plugin's /quote endpoint requires as X-LL-Secret. Same
# value as the WordPress option `ll_bridge_secret` and the frontend's Vercel
# env var. Rotate all three together:
#   ssh lilloaves-wp "wp eval 'update_option(\"ll_bridge_secret\", bin2hex(random_bytes(32)), false);'"
LL_BRIDGE_SECRET=

# The mailbox that sends. A Gmail or Google Workspace address.
GMAIL_USER=

# A Google App Password for that account (16 characters, generated at
# https://myaccount.google.com/apppasswords with 2-Step Verification on).
# NOT the account's login password — Google rejects those for SMTP.
GMAIL_APP_PASSWORD=

# Where the bakery wants to receive orders. May be the same as GMAIL_USER.
ORDER_EMAIL=

# Comma-separated storefront origins allowed to call POST /api/notify. No
# trailing slashes. Anything not listed gets a 403 — this route sends mail,
# so an open one is a spam relay pointed at the bakery's inbox.
ALLOWED_ORIGINS=https://lilloaves.com,https://lil-loaves.vercel.app,http://localhost:5173

# Optional. Any transport nodemailer knows by name; defaults to gmail.
# MAIL_SERVICE=gmail

# Optional. Local port for `npm run dev`; Vercel ignores it.
# PORT=4100
